{
  "name": "void-transit",
  "version": "1.9.6",
  "description": "VOID TRANSIT — A hard science fiction text adventure",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm version patch --no-git-tag-version",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/frontend','dist/frontend',{recursive:true});fs.cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "npm run build && node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild:browser": "npm version patch --no-git-tag-version",
    "build:browser": "vite build",
    "postbuild:browser": "node -e \"const v=require('./package.json').version;const{execSync}=require('child_process');try{execSync('git tag v'+v)}catch{}\"",
    "preview": "vite preview",
    "decode": "ts-node scripts/decode-data.ts",
    "encode": "ts-node scripts/encode-from-plain.ts"
  },
  "keywords": [
    "text-adventure",
    "sci-fi",
    "interactive-fiction"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
