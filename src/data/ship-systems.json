  "cascadeRules": [
    {
      "if": "power.distribution_grid.busB_status === 'failed'",
      "then": ["life_support.temperature_control.heatingCapacity = 0.6", "power.fusion_reactor.output_kw = 4200"],
      "description": "Bus B failure reduces power to Deck C heating and limits reactor output monitoring"
    },
    {
      "if": "power.fusion_reactor.shieldingIntegrity < 0.7",
      "then": ["power.fusion_reactor.output_kw = Math.min(output, 5000)"],
      "description": "Low shielding forces automatic reactor throttle"
    },
    {
      "if": "life_support.co2_scrubbers.co2_ppm > 30000",
      "then": ["player.status.dizzy = true", "player.status.impaired = true"],
      "description": "High CO2 causes player impairment"
    },
    {
      "if": "life_support.co2_scrubbers.co2_ppm > 50000",
      "then": ["player.status.unconscious = true"],
      "description": "Lethal CO2 levels"
    },
    {
      "if": "hull.primary_hull.atmosphereLossRate_pa_hr > 50",
      "then": ["life_support.o2_generator.efficiency -= 0.1"],
      "description": "Significant atmosphere loss strains O2 generation"
    }
  ],
